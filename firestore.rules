rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function belongsToGroup(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/studyGroups/$(groupId)).data.memberIds;
    }

    match /studyGroups/{groupId} {
      // Invite codes are the group document IDs. A signed-in user can fetch a
      // group by a code they know; list queries remain member-only.
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.inviteCode == groupId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 48;

      // Joining may add only the signed-in user; group metadata cannot be
      // changed by this join operation.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);

      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;

      match /matchHistory/{recordId} {
        allow read: if belongsToGroup(groupId);
        allow create: if belongsToGroup(groupId)
          && recordId == request.resource.data.sessionId
          && request.resource.data.createdById == request.auth.uid
          && request.resource.data.createdAt is string
          && request.resource.data.consideredMemberIds is list
          && request.resource.data.consideredMemberIds.size() <= 50
          && request.resource.data.consideredMemberIds.hasOnly(get(/databases/$(database)/documents/studyGroups/$(groupId)).data.memberIds)
          && request.resource.data.accommodatedMemberIds is list
          && request.resource.data.accommodatedMemberIds.size() <= 50
          && request.resource.data.accommodatedMemberIds.hasOnly(request.resource.data.consideredMemberIds)
          && !exists(/databases/$(database)/documents/sessions/$(recordId))
          && getAfter(/databases/$(database)/documents/sessions/$(recordId)).data.groupId == groupId
          && getAfter(/databases/$(database)/documents/sessions/$(recordId)).data.createdById == request.auth.uid;
        allow update, delete: if false;
      }

      match /availability/{userId} {
        allow read: if belongsToGroup(groupId);
        allow create, update: if belongsToGroup(groupId)
          && request.auth.uid == userId
          && request.resource.data.userId == userId
          && request.resource.data.displayName is string
          && request.resource.data.timezone is string
          && request.resource.data.slotKeys is list
          && request.resource.data.slotKeys.size() <= 21
          && request.resource.data.windows is list
          && request.resource.data.windows.size() <= 21;
        allow delete: if belongsToGroup(groupId) && request.auth.uid == userId;
      }
    }

    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.sessionName is string
        && request.resource.data.sessionName.size() > 0
        && request.resource.data.sessionName.size() <= 70
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 50
        && request.resource.data.start is string
        && request.resource.data.end is string
        && (!('groupId' in request.resource.data) || belongsToGroup(request.resource.data.groupId));
      allow update: if signedIn()
        && resource.data.createdById == request.auth.uid
        && request.resource.data.createdById == resource.data.createdById;
      allow delete: if signedIn() && resource.data.createdById == request.auth.uid;
    }
  }
}
